{
  "name": "ksf-webui",
  "private": true,
  "scripts": {
    "assets:vendor": "mkdir -p ./src/webui/static/vendor && cp ./node_modules/htmx.org/dist/htmx.min.js ./src/webui/static/vendor/htmx-2.0.8.min.js && cp ./node_modules/alpinejs/dist/cdn.min.js ./src/webui/static/vendor/alpine-3.15.3.min.js",
    "css:build": "tailwindcss -i ./src/webui/static/input.css -o ./src/webui/static/app.css --minify",
    "css:watch": "tailwindcss -i ./src/webui/static/input.css -o ./src/webui/static/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "alpinejs": "3.15.3",
    "htmx.org": "2.0.8",
    "tailwindcss": "^4.1.0"
  }
}
