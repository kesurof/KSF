APP_NAME=wordpress
APP_DESCRIPTION="WordPress - Site optimise (PHP-FPM + MariaDB + Redis)"
APP_CATEGORY=content
APP_HOST=www
APP_PORT=80
# APP_PROTECTED : true par defaut (cf. AGENTS.md). Pour exposer le blog publiquement
# sans OAuth2, repasser a l'install avec `./app.sh install wordpress --no-auth`.
APP_PUBLIC=true
# Service Docker a interroger en upstream (cf. compose.yml : service "web").
APP_DOCKER_SERVICE=web
